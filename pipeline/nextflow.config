/*
================================================================================
 Nextflow Pipeline Configuration: scRNA-seq Downstream Analysis
================================================================================
*/

manifest {
    name            = 'scrna-downstream-nf'
    author          = 'Computational Biology Team'
    description     = 'Automated End-to-End scRNA-seq Downstream Analysis Pipeline using Nextflow and Pixi'
    version         = '1.0.0'
    nextflowVersion = '!>=23.04.0'
}

// Default parameters
params {
    outdir          = "${launchDir}/results"
    trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// Default base resource allocations
includeConfig 'conf/base.config'

// Pipeline Execution Profiles
profiles {
    standard {
        process.executor = 'local'
        includeConfig 'conf/base.config'
    }

    local {
        process.executor = 'local'
        process.maxForks = 2
    }

    slurm {
        includeConfig 'conf/cluster.config'
    }

    pixi {
        // Automatically injects Pixi environment into execution PATH
        env {
            PATH        = "${projectDir}/.pixi/envs/default/bin:${launchDir}/.pixi/envs/default/bin:\$PATH"
            R_HOME      = "${projectDir}/.pixi/envs/default/lib/R"
            
        }
        process.beforeScript = '''
        if command -v pixi &> /dev/null; then
            eval "$(pixi shell-hook -s bash 2>/dev/null || true)"
        fi
        '''
    }

    test {
        includeConfig 'conf/test.config'
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g) --entrypoint ""'
        process.container = 'venkatbioinfo/v-scrna-seq-pipeline:latest'
    }
}

// Execution reporting & metrics
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_timestamp}.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_timestamp}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_timestamp}.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_timestamp}.html"
}
