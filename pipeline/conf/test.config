/*
================================================================================
 Nextflow Test Configuration Profile: scRATool Downstream Pipeline
================================================================================
 Minimal synthetic dataset configuration for fast continuous integration,
 validation testing, and stub execution.
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal synthetic dataset to check pipeline function'

    // Resource limits
    max_cpus                   = 2
    max_memory                 = '4.GB'
    max_time                   = '1.h'

    // Input data
    samplesheet                = "${projectDir}/assets/test_data/samples_test.csv"
    annotation_map             = "${projectDir}/assets/test_data/cluster_annotations_test.csv"
    outdir                     = "${launchDir}/results_test"
    reference_condition        = "CTRL"
    tissue                     = "Muscle"

    // Reduced thresholds for small test sets
    nfeature_min               = 10
    ncount_min                 = 20
    min_pct_cells              = 0.01
    n_hvg                      = 100
    npcs                       = 10
    qc_npcs                    = 10
    copykat_min_cells          = 10
    hdwgcna_min_cells          = 5
    hdwgcna_k_metacell         = 5
    hdwgcna_target_metacells   = 50
    hdwgcna_min_module_size    = 5
    cellchat_min_cells         = 3
    pb_min_counts              = 2
    pb_min_samples             = 1
}

process {
    cpus   = { 1 }
    memory = { 2.GB }
    time   = { 30.min }

    withLabel: 'process_low' {
        cpus   = { 1 }
        memory = { 2.GB }
        time   = { 30.min }
    }

    withLabel: 'process_medium' {
        cpus   = { 1 }
        memory = { 2.GB }
        time   = { 30.min }
    }

    withLabel: 'process_high' {
        cpus   = { 2 }
        memory = { 4.GB }
        time   = { 30.min }
    }
}
