/*
================================================================================
 Slurm HPC Cluster Configuration
================================================================================
 Edit this file or pass parameters (--queue <name>, --cluster_options '<opts>')
 to match your cluster's partition, node memory limits, and walltimes.
================================================================================
*/

params {
    // Cluster partition or queue (e.g. 'batch', 'gpu', 'standard', 'compute')
    // Leave null if your cluster does not require a partition flag.
    queue           = null

    // Additional sbatch options (e.g. '--account=my_lab')
    cluster_options = null
}

process {
    // Workload manager: 'slurm' (default), or 'sge', 'pbs', 'lsf'
    executor        = 'slurm'
    queue           = params.queue
    clusterOptions  = params.cluster_options

    // Automatic retry on transient OOM / walltime signals
    errorStrategy   = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries      = 2

    // Resource allocation tiers
    withLabel: 'process_low' {
        cpus   = { 2 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel: 'process_medium' {
        cpus   = { 8 * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }

    withLabel: 'process_high' {
        cpus   = { 16 * task.attempt }
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
}

executor {
    queueSize         = 50
    submitRateLimit   = '10 sec'
    pollInterval      = '10 sec'
}
