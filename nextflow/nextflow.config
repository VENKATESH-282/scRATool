// =============================================================================
//  nextflow.config  –  scRNA-seq Complete Pipeline  (Parts 1–11)
//  NGS101 | Version 3.0.0
//
//  Supports three input modes:
//    1. --input  <samples.csv>     Full pipeline from raw FASTQs
//    2. --matrix <matrix.csv>      Start from 10X MEX count matrices (skip CellRanger)
//    3. --seurat_rds <merged.rds>  Start from a pre-merged Seurat object (skip to Annotation)
// =============================================================================

// ─── Default Parameters ──────────────────────────────────────────────────────
params {

    // ── Input Modes (choose one) ─────────────────────────────────────────────
    //   Mode 1: Full pipeline from raw FASTQs
    input            = ""            // Path to samplesheet CSV

    //   Mode 2: Start from per-sample 10X MEX count matrices
    //   CSV format: sample_id, matrix_dir, condition, patient_id
    matrix           = ""

    //   Mode 3: Start from a pre-merged/integrated Seurat RDS
    //   Skips CellRanger, QC, and Integration — jumps directly to Annotation
    seurat_rds       = ""

    // ── Output ───────────────────────────────────────────────────────────────
    outdir           = "results"

    // ── Help ─────────────────────────────────────────────────────────────────
    help             = false

    // ── Pipeline Control ─────────────────────────────────────────────────────
    start_from       = ""           // (legacy) cellranger | qc | clustering | annotation | de

    // ── Reference Paths ──────────────────────────────────────────────────────
    //   Set these to your server-specific paths, or override on the command line
    //   e.g. --ref_human /path/to/refdata-gex-GRCh38-2024-A
    ref_human        = ""           // CellRanger-compatible human genome reference
    ref_mouse        = ""           // Only needed for PDX (human-mouse xenograft) experiments
    nichenet_models  = ""           // Optional: pre-downloaded NicheNet model directory

    // ── Resource Limits ──────────────────────────────────────────────────────
    //   Override per profile (see 'profiles' block below)
    max_cpus         = 32
    max_memory       = 64.GB
    max_time         = 48.h

    // ── Pre-existing CellRanger Output (used when --skip_cellranger) ─────────
    //   The pipeline searches: {cellranger_dir}/{sample_id}/outs
    cellranger_dir   = ""

    // ── CellRanger Parameters ────────────────────────────────────────────────
    chemistry        = "auto"       // Library chemistry (auto | SC3Pv3 | SC3Pv2 ...)
    expect_cells     = 5000         // Expected number of recovered cells per sample

    // ── Skip Flags ───────────────────────────────────────────────────────────
    //   Use these to restart the pipeline from a checkpoint or to skip optional steps
    skip_sra            = true       // Skip SRA download; local FASTQs must exist
    skip_cellranger     = false      // Skip CellRanger; set --cellranger_dir or use --matrix
    skip_pdx            = true       // Skip PDX species demultiplexing (for standard human data)
    skip_qc             = false      // Skip QC; use existing results/02_qc/ output
    skip_integration    = false      // Skip integration; use existing merged_clustered.rds
    skip_annotation     = false      // Skip annotation; use existing integrated_annotated.rds
    skip_de             = false      // Skip DE analysis; use existing de_results.rds
    skip_trajectory     = false      // Skip Slingshot trajectory analysis
    skip_cellchat       = false      // Skip CellChat cell-cell communication
    skip_nichenet       = false      // Skip NicheNet ligand-activity analysis
    skip_copykat        = false      // Skip CopyKAT CNV analysis (Part 11)

    // ── Stop-After Flags (early exit points) ─────────────────────────────────
    stop_after_qc           = false  // Exit after Part 2 (QC)
    stop_after_integration  = false  // Exit after Part 3 (Integration & Clustering)
    stop_after_annotation   = false  // Exit after Part 4 (Cell Annotation)
    stop_after_de           = false  // Exit after Part 5 (DE Analysis)
    stop_after_exploration  = false  // Exit after Part 6 (Exploration)

    // ── NicheNet Parameters ──────────────────────────────────────────────────
    nichenet_rds        = ""             // Input RDS for NICHENET_ONLY entry point
    nichenet_receiver   = "CD4+ T cells" // Receiver cell type
    nichenet_sender     = "all"          // Sender types: "all" or comma-separated list
    nichenet_condition_oi  = "Post"      // Condition of interest
    nichenet_condition_ref = "Healthy"   // Reference condition

    // ── CopyKAT Parameters ───────────────────────────────────────────────────
    copykat_rds         = ""             // Input RDS for COPYKAT_ONLY entry point
    copykat_genome      = "hg20"         // hg20 (human) or mm10 (mouse)
    copykat_n_cores     = 4
    copykat_ks_cut      = 0.1

    // ── QC Filtering Parameters ──────────────────────────────────────────────
    min_genes           = 500
    max_genes           = 5000
    min_umi             = 800
    max_umi             = 20000
    max_mt              = 10

    // ── Advanced Analysis Parameters ─────────────────────────────────────────
    norm_method         = "LogNormalize"
    norm_features       = 2000
    norm_batch          = false
    pca_dims            = 30
    pca_scale           = true
    tsne_perp           = 30
    umap_neighbors      = 30
    umap_mindist        = 0.3
    cluster_res         = 0.5
    cluster_alg         = 1
    cluster_test        = "wilcox"

    // ── Trajectory Parameters ────────────────────────────────────────────────
    traj_start          = "0"
    traj_downsample     = true
}

// ─── Process Labels & Resource Allocation ────────────────────────────────────
process {

    // Default fallback
    cpus   = 4
    memory = 16.GB
    time   = 4.h
    shell  = ['/bin/bash', '-eo', 'pipefail']

    withLabel: 'process_low' {
        cpus   = 2
        memory = 8.GB
        time   = 2.h
    }
    withLabel: 'process_medium' {
        cpus   = { Math.min(params.max_cpus as int, 16) }
        memory = { Math.min(params.max_memory.toGiga(), 64).GB }
        time   = 12.h
    }
    withLabel: 'process_high' {
        cpus   = { Math.min(params.max_cpus as int, 128) }
        memory = { Math.min(params.max_memory.toGiga(), 250).GB }
        time   = { params.max_time }
    }

    // Per-process overrides
    withName: 'DOWNLOAD_SRA' {
        cpus   = 16
        memory = 32.GB
    }
    withName: 'CELLRANGER_COUNT' {
        cpus   = { Math.min(params.max_cpus as int, 128) }
        memory = { Math.min(params.max_memory.toGiga(), 128).GB }
        time   = 24.h
    }
    withName: 'INTEGRATION_CLUSTERING' {
        cpus   = { Math.min(params.max_cpus as int, 128) }
        memory = { Math.min(params.max_memory.toGiga(), 250).GB }
        time   = 24.h
    }
    withName: 'CELLCHAT|NICHENET' {
        cpus   = { Math.min(params.max_cpus as int, 64) }
        memory = { Math.min(params.max_memory.toGiga(), 128).GB }
    }
    withName: 'COPYKAT' {
        cpus   = 8
        memory = 64.GB
        time   = 24.h
    }

    errorStrategy = { task.exitStatus in [137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
}

// ─── Profiles ─────────────────────────────────────────────────────────────────
//  Usage: nextflow run main.nf -profile <name>
//  Profiles can be combined: -profile slurm,conda
profiles {

    // ── Laptop / Workstation (low resources) ─────────────────────────────────
    laptop {
        process.executor   = 'local'
        params.max_cpus    = 8
        params.max_memory  = 12.GB
        params.max_time    = 48.h
    }

    // ── Standard local workstation ───────────────────────────────────────────
    local {
        process.executor   = 'local'
        params.max_cpus    = 32
        params.max_memory  = 64.GB
    }

    // ── High-memory local server ──────────────────────────────────────────────
    //   Configure ref_human and nichenet_models for your server.
    //   Example: nextflow run main.nf -profile server --ref_human /path/to/refdata-gex-GRCh38-2024-A
    server {
        process.executor   = 'local'
        params.max_cpus    = 128
        params.max_memory  = 512.GB
        // params.ref_human        = "/path/to/refdata-gex-GRCh38-2024-A"
        // params.nichenet_models  = "/path/to/nichenet/models"
    }

    // ── SLURM HPC (small partition) ─────────────────────────────────────────
    hpc_small {
        process.executor       = 'slurm'
        process.queue          = 'compute'
        process.clusterOptions = '--export=ALL'
        executor.queueSize     = 50
        params.max_cpus        = 32
        params.max_memory      = 64.GB
    }

    // ── SLURM HPC (large partition) ─────────────────────────────────────────
    hpc_large {
        process.executor       = 'slurm'
        process.queue          = 'highmem'
        process.clusterOptions = '--export=ALL'
        executor.queueSize     = 100
        params.max_cpus        = 128
        params.max_memory      = 512.GB
    }

    // ── Conda environment ────────────────────────────────────────────────────
    conda {
        conda.enabled      = true
        process.conda      = "${projectDir}/environment.yml"
    }

    // ── Singularity container ────────────────────────────────────────────────
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = 'docker://bioconductor/bioconductor_docker:RELEASE_3_18'
    }

    // ── Docker container ─────────────────────────────────────────────────────
    docker {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
        process.container  = 'docker://bioconductor/bioconductor_docker:RELEASE_3_18'
    }

    // ── Test (minimal run with bundled test data) ────────────────────────────
    test {
        process.executor   = 'local'
        params.input       = "${projectDir}/test/samples_test.csv"
        params.ref_human   = "${projectDir}/test/ref_mini"
        params.max_cpus    = 8
        params.max_memory  = 16.GB
        params.skip_pdx    = true
        params.stop_after_integration = true
    }
}

// ─── Metadata & Reporting ─────────────────────────────────────────────────────
manifest {
    name            = 'scRNA-seq Complete Pipeline'
    author          = 'NGS101'
    description     = 'End-to-end scRNA-seq analysis: CellRanger → QC → Integration → Annotation → DE → Trajectory → CellChat → NicheNet → CopyKAT'
    version         = '3.0.0'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.0.0'
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.svg"       }
